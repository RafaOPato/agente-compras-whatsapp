        "query": "SELECT EXISTS (\n  SELECT 1\n    FROM pergunta pe, cotacao cot\n   WHERE pe.id_cotacao = cot.id\n     AND cot.id_engenheiro = $1::int\n     AND pe.status = 'aberta'\n) AS ha_duvida;",
